{
  "name": "lte-lab-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador educacional LTE de Attach, S1 Handover, TAU e Paging — somente mocks",
  "main": "electron/main.cjs",
  "scripts": {
    "diagnose": "node scripts/diagnose.mjs",
    "test:diagnose": "node --test tests/diagnostics.test.mjs",
    "test:messages": "node --import tsx --test tests/messages.test.ts",
    "test:tau": "node --import tsx --test tests/tau.test.ts",
    "config:check": "node scripts/check-config.mjs",
    "test:config": "node --test tests/config.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "tsx --test tests/controller.test.ts",
    "test:ui": "node tests/ui.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:desktop": "node tests/desktop.cjs",
    "test:paging": "node --import tsx --test tests/paging.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
